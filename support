<!-- ===== SUCCESS MODAL ===== -->
<div id="successModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:200; align-items:center; justify-content:center;">
  <div style="background:var(--navy-card); border:2px solid var(--teal); border-radius:12px; padding:48px; max-width:500px; text-align:center;">
    <div style="font-size:48px; margin-bottom:16px;">&#10003;</div>
    <h2 style="font-family:'Oswald',sans-serif; font-size:28px; text-transform:uppercase; font-style:italic; margin-bottom:12px;">YOU'RE ALL SET!</h2>
    <p style="color:var(--gray-light); font-size:16px; margin-bottom:8px;">A Hyperco jersey expert will reach out within 24 hours.</p>
    <p style="color:var(--gray); font-size:13px; margin-bottom:32px;">Check your email for a confirmation.</p>
    <button class="btn-primary" onclick="document.getElementById('successModal').style.display='none'">GOT IT</button>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Smooth scroll for "Get Expert Help" buttons
  document.querySelectorAll('.btn-primary, .product-cta, .sticky-cta').forEach(function(btn) {
    if (btn.textContent.trim().includes('GET EXPERT HELP') || btn.textContent.trim().includes('CONNECT WITH AN EXPERT') || btn.textContent.trim().includes('Get Expert Help')) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        document.getElementById('configurator').scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  });

  // "Design It Yourself" buttons → link to hockey collection
  document.querySelectorAll('.btn-secondary').forEach(function(btn) {
    if (btn.textContent.trim().includes('DESIGN IT YOURSELF')) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        window.open('https://hypercosports.com/collections/hockey', '_blank');
      });
    }
  });

  // Sticky nav links
  document.querySelectorAll('.sticky-bar span').forEach(function(link) {
    var text = link.textContent.trim();
    if (text === 'Pricing') {
      link.addEventListener('click', function() {
        document.querySelector('.product-selector').scrollIntoView({ behavior: 'smooth' });
      });
    } else if (text === 'Gallery') {
      link.addEventListener('click', function() {
        document.querySelector('.gallery').scrollIntoView({ behavior: 'smooth' });
      });
    } else if (text === 'Reviews') {
      link.addEventListener('click', function() {
        document.querySelector('.testimonial').scrollIntoView({ behavior: 'smooth' });
      });
    }
  });

  // Form submission
  var formCard = document.querySelector('.form-card');
  var submitBtn = formCard.querySelector('.btn-primary');

  submitBtn.addEventListener('click', function(e) {
    e.preventDefault();

    // Basic validation
    var name = formCard.querySelector('input[placeholder="First & last name"]');
    var email = formCard.querySelector('input[type="email"]');
    var teamName = formCard.querySelector('input[placeholder*="Westside"]');

    if (!teamName.value.trim()) { teamName.style.borderColor = '#ff4444'; teamName.focus(); return; }
    if (!name.value.trim()) { name.style.borderColor = '#ff4444'; name.focus(); return; }
    if (!email.value.trim() || !email.value.includes('@')) { email.style.borderColor = '#ff4444'; email.focus(); return; }

    // Reset borders
    [teamName, name, email].forEach(function(f) { f.style.borderColor = 'var(--teal)'; });

    // Update step progress to show completion
    var circles = document.querySelectorAll('.step-circle');
    circles.forEach(function(c) { c.classList.remove('inactive'); c.classList.add('active'); });
    var labels = document.querySelectorAll('.step-label');
    labels.forEach(function(l) { l.classList.add('active-label'); });

    // Show success modal
    var modal = document.getElementById('successModal');
    modal.style.display = 'flex';
  });

  // Clear red border on input focus
  formCard.querySelectorAll('input, select, textarea').forEach(function(field) {
    field.addEventListener('focus', function() { this.style.borderColor = 'var(--teal)'; });
    field.addEventListener('blur', function() { if (!this.value) this.style.borderColor = 'rgba(255,255,255,0.1)'; });
  });

  // Browse links
  document.querySelectorAll('a').forEach(function(a) {
    if (a.textContent.includes('Browse all hockey')) {
      a.addEventListener('click', function(e) { e.preventDefault(); window.open('https://hypercosports.com/collections/hockey', '_blank'); });
    }
    if (a.textContent.includes('package deals')) {
      a.addEventListener('click', function(e) { e.preventDefault(); window.open('https://hypercosports.com/pages/hockey-package-deals', '_blank'); });
    }
    if (a.textContent.includes('jersey builder')) {
      a.addEventListener('click', function(e) { e.preventDefault(); window.open('https://hypercosports.com/collections/hockey', '_blank'); });
    }
  });
});
</script>
</body>
</html>
