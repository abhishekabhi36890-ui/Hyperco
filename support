<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hyperco Hockey Landing Page — Wireframe</title>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --navy: #171730;
  --navy-light: #1e1e3a;
  --navy-card: #232348;
  --teal: #5DFFC5;
  --teal-dim: #3dbf94;
  --white: #ffffff;
  --gray: #a0a0b8;
  --gray-light: #c8c8d8;
}

body {
  background: var(--navy);
  color: var(--white);
  font-family: 'Inter', sans-serif;
  line-height: 1.6;
  overflow-x: hidden;
}

.wireframe-badge {
  position: fixed;
  top: 16px;
  right: 16px;
  background: var(--teal);
  color: var(--navy);
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  z-index: 100;
}

.section-label {
  display: inline-block;
  background: rgba(93, 255, 197, 0.15);
  color: var(--teal);
  padding: 4px 14px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 12px;
}

h1, h2, h3, h4 {
  font-family: 'Oswald', sans-serif;
  text-transform: uppercase;
  font-style: italic;
  letter-spacing: 1px;
}

/* ===== SECTION 1: HERO ===== */
.hero {
  position: relative;
  min-height: 90vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: linear-gradient(180deg, var(--navy) 0%, #0d0d22 100%);
  overflow: hidden;
}

.hero-bg-placeholder {
  position: absolute;
  inset: 0;
  background: url('https://hypercosports.com/cdn/shop/files/rutgers-hero.png?v=1728492376&width=1500') center/cover no-repeat;
  opacity: 0.35;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(23,23,48,0.6) 0%, rgba(23,23,48,0.95) 100%);
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 800px;
  padding: 40px 24px;
}

.hero h1 {
  font-size: clamp(36px, 6vw, 64px);
  font-weight: 700;
  line-height: 1.1;
  margin-bottom: 16px;
}

.hero h1 span { color: var(--teal); }

.hero-sub {
  font-size: 18px;
  color: var(--gray-light);
  margin-bottom: 40px;
  font-weight: 300;
  max-width: 540px;
  margin-left: auto;
  margin-right: auto;
}

.hero-ctas {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
}

.btn-primary {
  background: var(--teal);
  color: var(--navy);
  padding: 16px 36px;
  border: none;
  border-radius: 4px;
  font-family: 'Oswald', sans-serif;
  font-size: 16px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-primary:hover { background: #7dffda; transform: translateY(-1px); }

.btn-secondary {
  background: transparent;
  color: var(--white);
  padding: 16px 36px;
  border: 1.5px solid rgba(255,255,255,0.3);
  border-radius: 4px;
  font-family: 'Oswald', sans-serif;
  font-size: 16px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 1px;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-secondary:hover { border-color: var(--teal); color: var(--teal); }

.hero-trust {
  margin-top: 40px;
  display: flex;
  gap: 32px;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
}

.trust-item {
  font-size: 12px;
  color: var(--gray);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.trust-item strong { color: var(--teal); font-size: 18px; display: block; }

/* ===== SECTION 2: PRODUCT SELECTOR (ECOMMERCE FEEL) ===== */
.product-selector {
  padding: 80px 24px;
  max-width: 1200px;
  margin: 0 auto;
}

.section-header {
  text-align: center;
  margin-bottom: 48px;
}

.section-header h2 {
  font-size: clamp(28px, 4vw, 42px);
  margin-bottom: 12px;
}

.section-header p {
  color: var(--gray);
  font-size: 16px;
  max-width: 560px;
  margin: 0 auto;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
}

.product-card {
  background: var(--navy-card);
  border-radius: 8px;
  overflow: hidden;
  border: 1.5px solid transparent;
  transition: all 0.3s;
  cursor: pointer;
}

.product-card:hover { border-color: var(--teal); transform: translateY(-4px); }
.product-card.popular { border-color: rgba(93,255,197,0.4); }

.popular-badge {
  background: var(--teal);
  color: var(--navy);
  text-align: center;
  padding: 6px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.product-img {
  height: 220px;
  background: var(--navy-light);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.product-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-img-placeholder {
  color: var(--gray);
  font-size: 13px;
  text-align: center;
}

.product-info {
  padding: 20px;
}

.product-info h3 {
  font-size: 20px;
  font-style: italic;
  margin-bottom: 4px;
}

.product-price {
  color: var(--teal);
  font-family: 'Oswald', sans-serif;
  font-size: 18px;
  margin-bottom: 8px;
}

.product-features {
  list-style: none;
  margin-bottom: 16px;
}

.product-features li {
  font-size: 13px;
  color: var(--gray);
  padding: 3px 0;
}

.product-features li::before {
  content: "✓ ";
  color: var(--teal);
  font-weight: 600;
}

.product-cta {
  width: 100%;
  background: rgba(93,255,197,0.1);
  color: var(--teal);
  border: 1px solid rgba(93,255,197,0.3);
  padding: 12px;
  border-radius: 4px;
  font-family: 'Oswald', sans-serif;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 1px;
  cursor: pointer;
  transition: all 0.2s;
}

.product-cta:hover { background: var(--teal); color: var(--navy); }

/* ===== SECTION 3: CONFIGURE YOUR ORDER (DISGUISED LEAD FORM) ===== */
.configurator {
  padding: 80px 24px;
  background: var(--navy-light);
}

.configurator-inner {
  max-width: 900px;
  margin: 0 auto;
}

.steps-progress {
  display: flex;
  justify-content: center;
  gap: 0;
  margin-bottom: 48px;
}

.step-dot {
  display: flex;
  align-items: center;
  gap: 0;
}

.step-circle {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Oswald', sans-serif;
  font-size: 16px;
  font-weight: 600;
  transition: all 0.3s;
}

.step-circle.active {
  background: var(--teal);
  color: var(--navy);
}

.step-circle.inactive {
  background: var(--navy-card);
  color: var(--gray);
  border: 1px solid rgba(255,255,255,0.1);
}

.step-line {
  width: 80px;
  height: 2px;
  background: rgba(255,255,255,0.1);
  margin: 0 8px;
  align-self: center;
}

.step-label {
  font-size: 11px;
  color: var(--gray);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-top: 8px;
  text-align: center;
}

.step-label.active-label { color: var(--teal); }

.form-card {
  background: var(--navy-card);
  border-radius: 12px;
  padding: 40px;
  border: 1px solid rgba(255,255,255,0.06);
}

.form-card h3 {
  font-size: 24px;
  margin-bottom: 8px;
}

.form-card .form-sub {
  color: var(--gray);
  font-size: 14px;
  margin-bottom: 32px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 20px;
}

.form-group { display: flex; flex-direction: column; }
.form-group.full { grid-column: 1 / -1; }

.form-group label {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--gray);
  margin-bottom: 8px;
}

.form-group input,
.form-group select,
.form-group textarea {
  background: var(--navy);
  border: 1px solid rgba(255,255,255,0.1);
  color: var(--white);
  padding: 14px 16px;
  border-radius: 4px;
  font-size: 14px;
  font-family: 'Inter', sans-serif;
  transition: border-color 0.2s;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--teal);
}

.form-group input::placeholder { color: rgba(255,255,255,0.25); }

.form-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 32px;
}

.form-note {
  font-size: 12px;
  color: var(--gray);
  max-width: 300px;
}

/* ===== SECTION 4: HOW IT WORKS ===== */
.how-it-works {
  padding: 80px 24px;
  max-width: 1000px;
  margin: 0 auto;
}

.steps-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  margin-top: 48px;
}

.step-card {
  text-align: center;
  padding: 32px 24px;
}

.step-number {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: rgba(93,255,197,0.1);
  border: 2px solid var(--teal);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  font-family: 'Oswald', sans-serif;
  font-size: 24px;
  color: var(--teal);
  font-weight: 600;
}

.step-card h4 {
  font-size: 18px;
  margin-bottom: 8px;
}

.step-card p {
  font-size: 14px;
  color: var(--gray);
  line-height: 1.7;
}

/* ===== SECTION 5: SOCIAL PROOF GALLERY ===== */
.gallery {
  padding: 80px 24px;
  background: var(--navy-light);
}

.gallery-inner { max-width: 1200px; margin: 0 auto; }

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-top: 48px;
}

.gallery-item {
  aspect-ratio: 1;
  border-radius: 8px;
  overflow: hidden;
  position: relative;
}

.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s;
}

.gallery-item:hover img { transform: scale(1.05); }

.gallery-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12px;
  background: linear-gradient(transparent, rgba(0,0,0,0.7));
  font-size: 12px;
  font-weight: 500;
}

/* ===== SECTION 6: TESTIMONIAL ===== */
.testimonial {
  padding: 80px 24px;
  text-align: center;
}

.testimonial-inner {
  max-width: 700px;
  margin: 0 auto;
}

.stars {
  color: var(--teal);
  font-size: 24px;
  margin-bottom: 24px;
  letter-spacing: 4px;
}

.testimonial blockquote {
  font-size: 18px;
  font-style: italic;
  line-height: 1.8;
  color: var(--gray-light);
  margin-bottom: 24px;
}

.testimonial cite {
  font-style: normal;
  font-size: 14px;
  color: var(--teal);
}

/* ===== SECTION 7: PRICING TRANSPARENCY ===== */
.pricing {
  padding: 80px 24px;
  background: var(--navy-light);
}

.pricing-inner { max-width: 1000px; margin: 0 auto; }

.pricing-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
  margin-top: 48px;
}

.pricing-card {
  background: var(--navy-card);
  border-radius: 8px;
  padding: 32px;
  border: 1px solid rgba(255,255,255,0.06);
  text-align: center;
}

.pricing-card.featured {
  border-color: var(--teal);
  position: relative;
}

.pricing-card h3 {
  font-size: 22px;
  margin-bottom: 8px;
}

.pricing-amount {
  font-family: 'Oswald', sans-serif;
  font-size: 36px;
  color: var(--teal);
  margin-bottom: 4px;
}

.pricing-per {
  font-size: 13px;
  color: var(--gray);
  margin-bottom: 24px;
}

.pricing-list {
  list-style: none;
  text-align: left;
  margin-bottom: 24px;
}

.pricing-list li {
  padding: 8px 0;
  font-size: 14px;
  color: var(--gray-light);
  border-bottom: 1px solid rgba(255,255,255,0.04);
}

.pricing-list li::before {
  content: "✓ ";
  color: var(--teal);
}

/* ===== SECTION 8: FINAL CTA ===== */
.final-cta {
  padding: 100px 24px;
  text-align: center;
  position: relative;
}

.final-cta h2 {
  font-size: clamp(32px, 5vw, 48px);
  margin-bottom: 16px;
}

.final-cta p {
  color: var(--gray);
  font-size: 16px;
  max-width: 500px;
  margin: 0 auto 40px;
}

.final-cta .hero-ctas { margin-bottom: 24px; }

.urgency-note {
  font-size: 13px;
  color: var(--gray);
  margin-top: 16px;
}

/* ===== ANNOTATIONS ===== */
.annotation {
  position: relative;
  margin: 0;
}

.annotation::before {
  content: attr(data-note);
  position: absolute;
  left: -16px;
  top: 50%;
  transform: translateX(-100%) translateY(-50%);
  background: #ff6b4a;
  color: white;
  padding: 8px 14px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 500;
  max-width: 220px;
  white-space: normal;
  line-height: 1.4;
  z-index: 10;
  display: none;
}

/* ===== DESIGN NOTES PANEL ===== */
.design-notes {
  background: #0a0a1a;
  padding: 60px 24px;
  border-top: 2px solid var(--teal);
}

.design-notes-inner {
  max-width: 900px;
  margin: 0 auto;
}

.design-notes h2 {
  color: var(--teal);
  font-size: 28px;
  margin-bottom: 32px;
  font-style: normal;
}

.note-block {
  background: var(--navy-card);
  border-radius: 8px;
  padding: 24px;
  margin-bottom: 16px;
  border-left: 3px solid var(--teal);
}

.note-block h4 {
  font-size: 14px;
  color: var(--teal);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 8px;
  font-style: normal;
}

.note-block p, .note-block li {
  font-size: 14px;
  color: var(--gray-light);
  line-height: 1.7;
}

.note-block ul {
  padding-left: 20px;
  margin-top: 8px;
}

.note-block li { margin-bottom: 6px; }

/* ===== STICKY NAV ===== */
.sticky-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(23,23,48,0.95);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  padding: 12px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sticky-logo {
  font-family: 'Oswald', sans-serif;
  font-size: 20px;
  font-weight: 700;
  color: var(--teal);
  letter-spacing: 2px;
}

.sticky-cta {
  background: var(--teal);
  color: var(--navy);
  padding: 10px 24px;
  border: none;
  border-radius: 4px;
  font-family: 'Oswald', sans-serif;
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  cursor: pointer;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
  .form-row { grid-template-columns: 1fr; }
  .steps-grid { grid-template-columns: 1fr; gap: 16px; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .hero-trust { flex-direction: column; gap: 16px; }
}

/* ===== FLOATING ANNOTATION DOTS ===== */
.callout {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 107, 74, 0.15);
  border: 1px solid rgba(255, 107, 74, 0.4);
  color: #ff6b4a;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.divider {
  height: 1px;
  background: rgba(255,255,255,0.06);
  margin: 0;
}
</style>
</head>
